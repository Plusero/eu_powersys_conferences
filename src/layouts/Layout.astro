---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Power Systems Conferences",
  description = "Curated list of power systems and smart grid conferences in Europe.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="european-blue">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var themeStorageVersion = "2";
        var stored = localStorage.getItem("theme");
        var storedVersion = localStorage.getItem("theme-version");
        var theme =
          storedVersion === themeStorageVersion &&
          (stored === "light" || stored === "dark" || stored === "european-blue")
            ? stored
            : "european-blue";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="page-bg" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
