<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Change theme">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--star" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="m12 2.25 2.92 6.1 6.58.96-4.75 4.7 1.12 6.64L12 17.5l-5.87 3.15 1.12-6.64-4.75-4.7 6.58-.96L12 2.25Z"></path>
  </svg>
</button>

<script>
  type Theme = "european-blue" | "light" | "dark";

  const themeStorageVersion = "2";
  const themes: Theme[] = ["european-blue", "light", "dark"];
  const themeLabels: Record<Theme, string> = {
    "european-blue": "European blue",
    light: "Light",
    dark: "Dark",
  };

  function isTheme(value: string | null): value is Theme {
    return value === "european-blue" || value === "light" || value === "dark";
  }

  function getPreferredTheme(): Theme {
    const stored = localStorage.getItem("theme");
    const storedVersion = localStorage.getItem("theme-version");
    return storedVersion === themeStorageVersion && isTheme(stored)
      ? stored
      : "european-blue";
  }

  function applyTheme(theme: Theme) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    localStorage.setItem("theme-version", themeStorageVersion);
    toggle?.setAttribute("aria-label", `Change theme. Current theme: ${themeLabels[theme]}`);
    toggle?.setAttribute("title", `Theme: ${themeLabels[theme]}`);
  }

  const toggle = document.getElementById("theme-toggle");
  applyTheme(getPreferredTheme());

  toggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const index = themes.indexOf(isTheme(current) ? current : "european-blue");
    const next = themes[(index + 1) % themes.length];
    applyTheme(next);
  });
</script>
