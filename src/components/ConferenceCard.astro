---
import type { Conference } from "../lib/types";
import { formatDate, formatDateRange, deadlineStatus } from "../lib/format";
import { getSubmissionStatus, getSubmissionThreshold } from "../lib/submission";
import { getLocationFlag } from "../lib/flags";

interface Props {
  conference: Conference;
}

const { conference: c } = Astro.props;
const locationFlag = getLocationFlag(c.location);
const submissionStatus = getSubmissionStatus(c);
const threshold = getSubmissionThreshold(c.deadlines);
const dateLabel =
  c.dates?.start && c.dates?.end
    ? formatDateRange(c.dates.start, c.dates.end)
    : null;

const deadlineItems = [
  { kind: "Abstract", date: c.deadlines.abstract, key: "abstract" as const },
  { kind: "Full paper", date: c.deadlines.fullPaper, key: "fullPaper" as const },
].filter((d) => d.date);

const showBadge =
  submissionStatus.kind === "accepting" || submissionStatus.kind === "opens_soon";
---

<article
  class:list={[
    "conference-card",
    submissionStatus.kind === "accepting" && "conference-card--accepting",
    submissionStatus.kind === "opens_soon" && "conference-card--opens-soon",
  ]}
  data-year={c.year ?? ""}
  data-org={c.org ?? ""}
  data-accepting={submissionStatus.kind === "accepting" ? "true" : "false"}
  data-opens-soon={submissionStatus.kind === "opens_soon" ? "true" : "false"}
>
  {showBadge && (
    <p class="submission-badge" data-status={submissionStatus.kind}>
      <span class="submission-badge__dot" aria-hidden="true"></span>
      {submissionStatus.detail
        ? `${submissionStatus.label} · ${submissionStatus.detail}`
        : submissionStatus.label}
    </p>
  )}

  <header class="card-header">
    <h2>
      {c.website ? (
        <a href={c.website} target="_blank" rel="noopener noreferrer">
          {c.shortTitle}
        </a>
      ) : (
        c.shortTitle
      )}
    </h2>
    {c.org && <span class="org-badge" data-org={c.org}>{c.org}</span>}
  </header>

  {c.location && (
    <p class="location">
      {locationFlag ? (
        <img
          class="location-flag"
          src={locationFlag.imageUrl}
          alt=""
          width={24}
          height={18}
          loading="lazy"
          decoding="async"
          title={locationFlag.country}
        />
      ) : (
        <span aria-hidden="true">📍</span>
      )}
      {c.location}
    </p>
  )}

  {dateLabel && c.dates && (
    <div class="dates-block">
      <span class="label">Conference dates</span>
      <span class="value">
        <time datetime={c.dates.start}>{dateLabel}</time>
      </span>
    </div>
  )}

  {deadlineItems.length > 0 && (
    <section class="deadlines" aria-label="Submission deadlines">
      <h3>Deadlines</h3>
      <ul class="deadline-list">
        {deadlineItems.map(({ kind, date, key }) => (
          <li
            data-status={deadlineStatus(date!)}
            data-threshold={threshold?.kind === key ? "true" : "false"}
          >
            <span class="kind">
              {kind}
              {threshold?.kind === key && (
                <span class="threshold-tag">submission cutoff</span>
              )}
            </span>
            <time datetime={date!}>{formatDate(date!)}</time>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.acceptanceRate != null && (
    <p class="acceptance">
      Historical acceptance rate: <strong>{c.acceptanceRate}%</strong>
    </p>
  )}

  {c.website && (
    <div class="card-links">
      <a href={c.website} target="_blank" rel="noopener noreferrer">
        Official site →
      </a>
    </div>
  )}
</article>
